{
  "name": "film-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && vite build",
    "preview": "vite preview",
    "manifest": "node scripts/build-manifest.mjs",
    "encode": "bash scripts/encode-hls.sh",
    "bg": "bash scripts/build-bg.sh",
    "upload": "bash scripts/upload-r2.sh",
    "upload:wrangler": "node scripts/upload-wrangler.mjs",
    "deploy": "node scripts/deploy.mjs",
    "demo": "bash scripts/make-demo-media.sh && node scripts/build-manifest.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
